# окружение и локальные настройки
.venv/
__pycache__/
config.json
.openai_key

# рабочие данные: пропы, логи, кэш описаний, расход токенов
work/
input/

# панорамы 4k качаются при установке (tools/doctor.py download --group hdri); 1k лежат в репозитории
web/hdri/*_4k.hdr

# сборка инсталлятора (tools/build/build.py): папка программы, кэш скачанного, готовый setup.exe
# (с ведущим слешем: просто build/ спрятал бы и tools/build/ со скриптами сборки)
/build/
/dist/
# признак установленной копии — пишет сборка в {app}, в репозитории его быть не должно
/installed.json
